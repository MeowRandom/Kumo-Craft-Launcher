<Window x:Class="Kumo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Kumo"
        xmlns:behaviors="clr-namespace:Kumo.Behaviors"
        xmlns:controls="clr-namespace:Kumo.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="库莫 · Kumo Launcher"
        Width="1280" Height="760" MinWidth="900" MinHeight="560"
        AllowDrop="True"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource BgBrush}" WindowStartupLocation="CenterScreen"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed"
        DragEnter="Window_DragEnter" DragOver="Window_DragOver"
        DragLeave="Window_DragLeave" Drop="Window_Drop"
        StateChanged="Window_StateChanged"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="7"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarPanel" Grid.Column="0" Width="210"
                Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                BorderThickness="0,0,1,0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="96" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="86" />
                </Grid.RowDefinitions>

                <Grid x:Name="SidebarHeader" Margin="14,23,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarLogoColumn" Width="48" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SidebarLogo" Width="42" Height="42" CornerRadius="12" Background="Transparent"
                            ClipToBounds="True"
                            Panel.ZIndex="100"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Image Source="Assets/logo.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <StackPanel x:Name="SidebarBrandPanel" Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="库莫" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="Kumo Craft Launcher" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" VerticalAlignment="Top" Margin="0,7,0,0">
                    <TextBlock x:Name="SidebarWorkspaceLabel" Text="工作台"
                               Style="{StaticResource Caption}" Margin="24,0,0,8"
                               FontWeight="SemiBold" />
                    <RadioButton x:Name="HomeNav" GroupName="Navigation" Content="首页"
                                 Style="{StaticResource NavButton}"
                                 IsChecked="True" Click="Navigation_Click">
                        <RadioButton.Tag>
                            <Viewbox Width="28" Height="28" Stretch="Uniform"
                                     RenderOptions.BitmapScalingMode="HighQuality">
                                <Border Width="28" Height="28"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                        SnapsToDevicePixels="False">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="Assets/NavBedSharp.png" Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                            </Viewbox>
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="ModsNav" GroupName="Navigation" Content="资源中心"
                                 Style="{StaticResource NavButton}"
                                 Click="Navigation_Click">
                        <RadioButton.Tag>
                            <Viewbox Width="28" Height="28" Stretch="Uniform"
                                     RenderOptions.BitmapScalingMode="HighQuality">
                                <Border Width="28" Height="28"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                        SnapsToDevicePixels="False">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="Assets/NavPickaxeSharp.png" Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                            </Viewbox>
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="MyVersionsNav" GroupName="Navigation" Content="本地版本"
                                 Style="{StaticResource NavButton}"
                                 Click="Navigation_Click">
                        <RadioButton.Tag>
                            <Viewbox Width="28" Height="28" Stretch="Uniform"
                                     RenderOptions.BitmapScalingMode="HighQuality">
                                <Border Width="28" Height="28"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                        SnapsToDevicePixels="False">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="Assets/NavBackpackSharp.png" Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                            </Viewbox>
                        </RadioButton.Tag>
                    </RadioButton>
                    <RadioButton x:Name="VersionsNav" GroupName="Navigation" Content="版本管理"
                                 Style="{StaticResource NavButton}"
                                 Click="Navigation_Click">
                        <RadioButton.Tag>
                            <Viewbox Width="28" Height="28" Stretch="Uniform"
                                     RenderOptions.BitmapScalingMode="HighQuality">
                                <Border Width="28" Height="28"
                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                        SnapsToDevicePixels="False">
                                    <Border.OpacityMask>
                                        <ImageBrush ImageSource="Assets/NavEnderEyeSharp.png" Stretch="Uniform" />
                                    </Border.OpacityMask>
                                </Border>
                            </Viewbox>
                        </RadioButton.Tag>
                    </RadioButton>
                </StackPanel>

                <Button x:Name="SidebarToggleButton"
                        Grid.Row="1"
                        Style="{StaticResource IconButton}"
                        Width="28" Height="28"
                        ToolTip="收起侧栏"
                        Margin="0,278,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="SidebarToggle_Click">
                    <Path x:Name="SidebarToggleIcon"
                          Data="M 7,1 L 2,8 L 7,15"
                          Width="9" Height="16"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" />
                </Button>

                <Button x:Name="SidebarSettingsButton" Grid.Row="2" Margin="15,0,15,15" Padding="12"
                        Background="{DynamicResource SidebarPanelBrush}"
                        BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1"
                        HorizontalContentAlignment="Stretch"
                        Cursor="Hand" FocusVisualStyle="{x:Null}"
                        ToolTip="打开设置" Click="KumoCard_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background"
                                            Value="{DynamicResource PanelHoverBrush}" />
                                    <Setter TargetName="Root" Property="BorderBrush"
                                            Value="{DynamicResource SecondaryHoverBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid x:Name="SidebarSettingsContent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SidebarBadgeBrush}">
                            <TextBlock Text="{x:Static app:AppInfo.CompactVersion}" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel x:Name="SidebarSettingsText"
                                    Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Kumo" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="正式版" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderTitle" Text="首页" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderSubtitle" Text="准备开始今天的方块冒险"
                               Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="HeaderAccountButton" Click="HeaderAccountButton_Click"
                            Style="{StaticResource AccountPillButton}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource HeaderAvatarSurfaceBrush}">
                                <Grid>
                                    <TextBlock x:Name="HeaderAccountInitial" Text="?"
                                               Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="HeaderAvatarImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           SnapsToDevicePixels="True" Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <StackPanel Margin="9,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="HeaderAccountName" Text="未登录" FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="HeaderAccountKind" Text="点击添加账户"
                                           FontSize="9" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="20" Background="{DynamicResource BorderSoftBrush}"
                            Margin="5,0,8,0" />
                    <Button Style="{StaticResource WindowButton}" ToolTip="最小化"
                            Click="Minimize_Click">
                        <Path Data="M 1,6 L 11,6" Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                    <Button Style="{StaticResource WindowButton}" ToolTip="关闭"
                            Click="Close_Click">
                        <Path Data="M 1.5,1.5 L 10.5,10.5 M 10.5,1.5 L 1.5,10.5"
                              Width="12" Height="12"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="28,10,28,8">
                <!-- Home -->
                <Grid x:Name="HomeLegacyPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  behaviors:SmoothScroll.IsEnabled="True">
                        <StackPanel>
                            <Border MinHeight="310" CornerRadius="18" Background="{DynamicResource HeroGradient}"
                                    BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="1" ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="320" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Ellipse Width="430" Height="430" Fill="{DynamicResource HeroGlowBrush}" Opacity="0.08"
                                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                                 Margin="0,-40,-160,0" />
                                        <StackPanel Margin="36,34,36,32" MaxWidth="600"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="JAVA EDITION" Style="{StaticResource Eyebrow}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="方块世界，从这里点亮。" FontFamily="{StaticResource DisplayFont}"
                                                       FontSize="32" FontWeight="SemiBold" Margin="0,10,0,5"
                                                       TextAlignment="Center" />
                                            <TextBlock Text="选择版本并直接进入游戏，Mod 与存档按游戏版本隔离保存。"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13"
                                                       TextAlignment="Center" />
                                            <StackPanel Margin="0,24,0,0" HorizontalAlignment="Center">
                                                <ComboBox x:Name="LegacyHomeVersionCombo"
                                                          Width="320"
                                                          ItemTemplate="{StaticResource HomeVersionDisplay}"
                                                          SelectionChanged="HomeVersionCombo_SelectionChanged" />
                                                <Button x:Name="LegacyLaunchButton" Content="启动游戏"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Width="190" Padding="22,14" FontSize="14"
                                                        HorizontalAlignment="Center" Margin="0,12,0,0"
                                                        Click="LaunchButton_Click" />
                                                <TextBlock x:Name="LegacyHomeLaunchStatusText" Text=""
                                                           Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap"
                                                           Margin="0,8,0,0" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                                        HorizontalAlignment="Center">
                                                <Border x:Name="LegacyHomeLoaderBadge" Style="{StaticResource SmallBadge}">
                                                    <TextBlock x:Name="LegacyHomeLoaderText" Text="等待选择版本"
                                                               FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock x:Name="LegacyHomeVersionMeta" Text="尚未安装任何版本"
                                                           Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                           Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Border Grid.Column="1" Background="{DynamicResource AccountPanelBrush}" BorderBrush="{DynamicResource AccountDividerBrush}"
                                            BorderThickness="1,0,0,0" Padding="26,30">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="当前账户" Style="{StaticResource Caption}" />
                                            <Grid Margin="0,20,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="15" Background="{DynamicResource AccountAvatarSurfaceBrush}">
                                                    <Grid>
                                                        <TextBlock x:Name="LegacyHomeAccountInitial" Text="?"
                                                                   FontSize="19" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image x:Name="LegacyHomeAvatarImage" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               SnapsToDevicePixels="True" Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="LegacyHomeAccountName" Text="未登录"
                                                               FontSize="15" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="LegacyHomeAccountKind" Text="离线或正版账户"
                                                               Style="{StaticResource Caption}" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Style="{StaticResource Divider}" Margin="0,20,0,16" />
                                            <TextBlock Text="正版登录仅通过 Microsoft 官方页面完成，启动器不会读取你的密码。"
                                                       FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                                                       LineHeight="16" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="17">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="已安装版本" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="LegacyInstalledCountText" Text="0" FontSize="25"
                                                       FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                                       Margin="0,7,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12"
                                                Background="{DynamicResource AccentSurfaceBrush}">
                                            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Mod 版本" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="LegacyModdedCountText" Text="0" FontSize="25"
                                                       FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                                       Margin="0,7,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12"
                                                Background="{DynamicResource InfoSurfaceBrush}">
                                            <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}"
                                                       Foreground="{DynamicResource CyanBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource Card}" Padding="17">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="账户" Style="{StaticResource Caption}" />
                                            <TextBlock x:Name="LegacyAccountCountText" Text="0" FontSize="25"
                                                       FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold"
                                                       Margin="0,7,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="38" Height="38" CornerRadius="12"
                                                Background="{DynamicResource DangerSurfaceBrush}">
                                            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}"
                                                       Foreground="{DynamicResource DangerAccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="启动动态" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="下载、登录与游戏输出会实时显示在这里。"
                                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Grid Grid.Column="1" Height="32" Margin="16,0,0,0"
                                              HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="LegacyLatestVersionText" Text="正在获取最新版本…"
                                                       Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <Button Grid.Column="1" Content="打开日志"
                                                    Style="{StaticResource GhostButton}"
                                                    Height="32" Padding="10,0"
                                                    VerticalContentAlignment="Center"
                                                    Click="OpenLog_Click" />
                                        </Grid>
                                    </Grid>
                                    <Border Grid.Row="1" Style="{StaticResource InsetCard}" Margin="0,15,0,0"
                                            Padding="0">
                                        <TextBox x:Name="LegacyLogBox" IsReadOnly="True" AcceptsReturn="True"
                                                 TextWrapping="Wrap" MinHeight="112" MaxHeight="150"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 Background="Transparent" BorderThickness="0"
                                                 FontFamily="Cascadia Mono, Consolas" FontSize="10.5"
                                                 Foreground="{DynamicResource LogTextBrush}" Padding="13,11"
                                                 VerticalContentAlignment="Top"
                                                 HorizontalContentAlignment="Left" />
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Redesigned Home -->
                <Grid x:Name="HomePage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Focusable="False"
                                  FocusVisualStyle="{x:Null}"
                                  behaviors:SmoothScroll.IsEnabled="True"
                                  ScrollChanged="HomePage_ScrollChanged">
                        <StackPanel>
                            <Border x:Name="HomeHeroCard"
                                    Height="330" CornerRadius="24"
                                    Background="{DynamicResource HeroGradient}"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True" UseLayoutRounding="True"
                                    Focusable="False" FocusVisualStyle="{x:Null}"
                                    SizeChanged="HomeHeroCard_SizeChanged">
                                <Grid>
                                    <Image x:Name="HomeHeroBackdropFill"
                                           Stretch="UniformToFill"
                                           Opacity="0.5"
                                           IsHitTestVisible="False"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True">
                                        <Image.Effect>
                                            <BlurEffect Radius="22" RenderingBias="Performance" />
                                        </Image.Effect>
                                    </Image>
                                    <Image x:Name="HomeHeroBackdrop"
                                           Stretch="Uniform"
                                           Opacity="0.82"
                                           IsHitTestVisible="False"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True" />
                                    <Border x:Name="HomeHeroArtFrame"
                                            Width="160" Height="160"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Margin="0,64,50,0"
                                            SnapsToDevicePixels="True">
                                        <Image x:Name="HomeHeroImage"
                                               Stretch="Uniform"
                                               SizeChanged="HomeHeroImage_SizeChanged"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <Border Background="{DynamicResource HomeHeroOverlayBrush}" />
                                    <Grid Margin="30,26,30,17">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <StackPanel MaxWidth="560"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top">
                                                <TextBlock Text="CURRENT VERSION"
                                                           Style="{StaticResource Eyebrow}"
                                                           Foreground="{DynamicResource HomeHeroAccentBrush}" />
                                                <Grid MaxWidth="560"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,9,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl x:Name="HomeHeroVersionIcon"
                                                                    Width="32" Height="32"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Center"
                                                                    IsHitTestVisible="False"
                                                                    ContentTemplate="{StaticResource LoaderIcon}" />
                                                    <TextBlock x:Name="HomeHeroVersionTitle"
                                                               Grid.Column="1"
                                                               Text="还没有游戏版本"
                                                               FontFamily="{StaticResource DisplayFont}"
                                                               FontSize="31" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HomeHeroTitleBrush}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock x:Name="HomeHeroVersionSubtitle"
                                                           Text="下载一个版本开始游戏"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource HomeHeroSecondaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top">
                                                <Button Content="替换封面"
                                                        Style="{StaticResource GhostButton}"
                                                        Foreground="{DynamicResource HomeHeroButtonTextBrush}"
                                                        BorderBrush="{DynamicResource HomeHeroButtonBorderBrush}"
                                                        Padding="10,6"
                                                        Click="ChooseHomeBackground_Click" />
                                                <Button x:Name="HomeResetBackgroundButton"
                                                        Content="使用默认"
                                                        Style="{StaticResource GhostButton}"
                                                        Foreground="{DynamicResource HomeHeroButtonTextBrush}"
                                                        BorderBrush="{DynamicResource HomeHeroButtonBorderBrush}"
                                                        Padding="10,6" Margin="7,0,0,0"
                                                        Visibility="Collapsed"
                                                        Click="ResetHomeBackground_Click" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,18,0,0">
                                            <StackPanel HorizontalAlignment="Left"
                                                        VerticalAlignment="Bottom">
                                                <ComboBox x:Name="HomeVersionCombo"
                                                          Width="246"
                                                          HorizontalAlignment="Left"
                                                          ItemTemplate="{StaticResource HomeVersionDisplay}"
                                                          SelectionChanged="HomeVersionCombo_SelectionChanged" />
                                                <TextBlock x:Name="HomeLaunchStatusText" Text=""
                                                           FontSize="11"
                                                           Foreground="{DynamicResource HomeHeroSecondaryBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="2,8,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                    <Button x:Name="LaunchButton"
                                            Content="启动游戏"
                                            Style="{StaticResource PrimaryButton}"
                                            Width="204" Height="52"
                                            Padding="24,10" FontSize="15"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,46,38"
                                            Click="LaunchButton_Click" />
                                    <Border Margin="0.5"
                                            CornerRadius="23.5"
                                            BorderBrush="{DynamicResource HeroBorderBrush}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False"
                                            SnapsToDevicePixels="True" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,16,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.82*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="1.35*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="24">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="账户" Style="{StaticResource SectionTitle}" />
                                            <Border Style="{StaticResource SmallBadge}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock x:Name="AccountCountText" Text="0"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Row="1"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="0,28,0,28">
                                            <Button HorizontalAlignment="Center"
                                                    Cursor="Hand" FocusVisualStyle="{x:Null}"
                                                    Click="HomeAccountAvatar_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <ContentPresenter />
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Border Width="86" Height="86" CornerRadius="24"
                                                        Background="{DynamicResource AccountAvatarSurfaceBrush}">
                                                    <Grid>
                                                        <TextBlock x:Name="HomeAccountInitial" Text="?"
                                                                   FontSize="30" FontWeight="Bold"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                        <Image x:Name="HomeAvatarImage" Stretch="Uniform"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                               SnapsToDevicePixels="True"
                                                               Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                            </Button>
                                            <TextBlock x:Name="HomeAccountName" Text="未登录"
                                                       FontSize="19" FontWeight="SemiBold"
                                                       TextAlignment="Center"
                                                       Margin="0,15,0,3" />
                                            <TextBlock x:Name="HomeAccountKind"
                                                       Text="离线或正版账户"
                                                       Style="{StaticResource Caption}"
                                                       TextAlignment="Center" />
                                        </StackPanel>
                                        <Button x:Name="HomePreviousAccountButton"
                                                Grid.Row="1"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="上一个账户"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"
                                                Click="HomePreviousAccount_Click">
                                            <Path Data="M 8,1 L 2,8 L 8,15"
                                                  Width="10" Height="16"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Button>
                                        <Button x:Name="HomeNextAccountButton"
                                                Grid.Row="1"
                                                Style="{StaticResource IconButton}"
                                                ToolTip="下一个账户"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Visibility="Collapsed"
                                                Click="HomeNextAccount_Click">
                                            <Path Data="M 2,1 L 8,8 L 2,15"
                                                  Width="10" Height="16"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round" />
                                        </Button>
                                    </Grid>
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="14" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="版本" Style="{StaticResource SectionTitle}" />
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right">
                                                    <Button Content="管理版本"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="10,5"
                                                            Click="DownloadNewVersion_Click" />
                                                    <Button Content="下载新版本"
                                                            Style="{StaticResource SecondaryButton}"
                                                            Padding="12,6" Margin="7,0,0,0"
                                                            Click="DownloadNewVersion_Click" />
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,16,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource InsetCard}"
                                                        Padding="14,12">
                                                    <StackPanel>
                                                        <TextBlock Text="已安装版本"
                                                                   Style="{StaticResource Caption}" />
                                                        <TextBlock x:Name="InstalledCountText" Text="0"
                                                                   FontSize="25" FontWeight="SemiBold"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Column="2"
                                                        Style="{StaticResource InsetCard}"
                                                        Padding="14,12">
                                                    <StackPanel>
                                                        <TextBlock Text="Mod 版本"
                                                                   Style="{StaticResource Caption}" />
                                                        <TextBlock x:Name="ModdedCountText" Text="0"
                                                                   FontSize="25" FontWeight="SemiBold"
                                                                   Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                                <Border x:Name="HomeLoaderBadge"
                                                        Style="{StaticResource SmallBadge}">
                                                    <TextBlock x:Name="HomeLoaderText"
                                                               Text="等待选择版本"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock x:Name="HomeVersionMeta"
                                                           Text="尚未安装任何版本"
                                                           Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="2" Style="{StaticResource Card}"
                                            Padding="20,18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="日志"
                                                               Style="{StaticResource SectionTitle}" />
                                                    <TextBlock Text="下载、登录与游戏输出会实时显示在这里。"
                                                               Style="{StaticResource Caption}"
                                                               Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center">
                                                    <TextBlock x:Name="LatestVersionText"
                                                               Text="正在获取最新版本…"
                                                               Style="{StaticResource Caption}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0" />
                                                    <Button Content="打开日志"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="10,5"
                                                            Click="OpenLog_Click" />
                                                </StackPanel>
                                            </Grid>
                                            <Border Grid.Row="1"
                                                    Style="{StaticResource InsetCard}"
                                                    Margin="0,14,0,0" Padding="0">
                                                <TextBox x:Name="LogBox"
                                                         IsReadOnly="True"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         MinHeight="170" MaxHeight="230"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         FontFamily="Cascadia Mono, Consolas"
                                                         FontSize="10.5"
                                                         Foreground="{DynamicResource LogTextBrush}"
                                                         Padding="13,11"
                                                         VerticalContentAlignment="Top"
                                                         HorizontalContentAlignment="Left" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- My versions -->
                <Grid x:Name="MyVersionsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}" Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本地版本" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="MyVersionsSummaryText"
                                           Text="所有已安装版本集中显示在这里"
                                           Style="{StaticResource Caption}" Margin="0,5,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="刷新列表" Style="{StaticResource SecondaryButton}"
                                        Click="RefreshMyVersions_Click" Margin="0,0,9,0" />
                                <Button Content="下载新版本" Style="{StaticResource PrimaryButton}"
                                        Click="DownloadNewVersion_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="2,13,2,8">
                        <TextBlock Text="点击“启动”直接进入游戏；“检查文件”会补齐缺失资源。"
                                   Style="{StaticResource Caption}" />
                        <TextBlock x:Name="MyVersionsCountText" Text="0 个版本"
                                   Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="MyVersionsList" Style="{StaticResource CleanListBox}"
                                 behaviors:SmoothScroll.IsEnabled="True"
                                 ItemContainerStyle="{StaticResource CleanListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ListItemBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1" CornerRadius="11" Padding="15,13">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" CornerRadius="13" Background="{DynamicResource LoaderIconSurfaceBrush}"
                                                    VerticalAlignment="Top">
                                                <ContentControl Width="28" Height="28"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                Content="{Binding}"
                                                                ContentTemplate="{StaticResource LoaderIcon}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="13,0,18,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="15"
                                                               FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource SmallBadge}" Margin="9,0,0,0"
                                                            Padding="7,2">
                                                        <TextBlock Text="{Binding LoaderLabel}" FontSize="9"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource SmallBadge}"
                                                            Background="{DynamicResource InfoBadgeBrush}"
                                                            Padding="7,2" Margin="6,0,0,0">
                                                        <TextBlock Text="{Binding ReadyLabel}" FontSize="9"
                                                                   Foreground="{DynamicResource CyanBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Caption}"
                                                           Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding Id}" FontSize="9"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,3,0,0" />
                                                <Button Content="查看已加载 Mod"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="0,3" Margin="0,5,0,0"
                                                        FontSize="10"
                                                        HorizontalAlignment="Left"
                                                        Tag="{Binding}" Click="MyVersionLoadedMods_Click"
                                                        Visibility="{Binding SupportsMods, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="Mod" Style="{StaticResource GhostButton}"
                                                        Tag="{Binding}" Click="MyVersionMods_Click"
                                                        Visibility="{Binding SupportsMods, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Button Content="打开目录" Style="{StaticResource GhostButton}"
                                                        Tag="{Binding}" Click="MyVersionOpenFolder_Click" />
                                                <Button Content="检查文件" Style="{StaticResource GhostButton}"
                                                        Tag="{Binding}" Click="MyVersionRepair_Click" />
                                                <Button Content="重命名" Style="{StaticResource GhostButton}"
                                                        Tag="{Binding}" Click="MyVersionRename_Click" />
                                                <Button Content="复制" Style="{StaticResource GhostButton}"
                                                        Tag="{Binding}" Click="MyVersionDuplicate_Click" />
                                                <Button Content="删除" Style="{StaticResource GhostButton}"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        Tag="{Binding}" Click="MyVersionDelete_Click" />
                                                <Button Content="启动" Style="{StaticResource PrimaryButton}"
                                                        Padding="18,8" Margin="8,0,0,0"
                                                        Tag="{Binding}" Click="MyVersionLaunch_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel x:Name="MyVersionsEmpty" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource EmptySurfaceBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}"
                                           FontSize="25" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="还没有安装游戏版本" FontSize="18" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,16,0,6" />
                            <TextBlock Text="前往版本管理下载 Minecraft，安装后会出现在这里。"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            <Button Content="前往下载版本" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Center" Margin="0,17,0,0"
                                    Click="DownloadNewVersion_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" Style="{StaticResource InsetCard}" Margin="0,10,0,0" Padding="13">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="版本数据位置" Style="{StaticResource Caption}" FontSize="10" />
                                <TextBlock x:Name="MyVersionsPathText" Text=""
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Content="打开版本总目录" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Right" Click="MyVersionsOpenRoot_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Versions -->
                <Grid x:Name="VersionsPage" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="300" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" MinWidth="260" MaxWidth="330" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="VersionSearchArea"
                                  Background="Transparent"
                                  Cursor="IBeam"
                                  Tag="{Binding ElementName=VersionSearchBox}"
                                  PreviewMouseLeftButtonDown="SearchArea_PreviewMouseLeftButtonDown">
                                <TextBox x:Name="VersionSearchBox"
                                         Style="{StaticResource SearchTextBox}"
                                         TextChanged="VersionSearchBox_TextChanged"
                                         PreviewMouseLeftButtonDown="SearchTextBox_PreviewMouseLeftButtonDown"
                                         PreviewMouseLeftButtonUp="SearchTextBox_PreviewMouseLeftButtonUp"
                                         GotKeyboardFocus="SearchBox_FocusChanged"
                                         LostKeyboardFocus="SearchBox_FocusChanged"
                                         FontSize="12" />
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                                           Margin="14,0,0,0" VerticalAlignment="Center"
                                           HorizontalAlignment="Left" IsHitTestVisible="False" />
                            </Grid>
                            <TextBlock x:Name="VersionSearchHint" Text="搜索 Minecraft 版本，例如 1.21.1"
                                       IsHitTestVisible="False" Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="38,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            <Button Grid.Column="1" Content="刷新清单" Style="{StaticResource SecondaryButton}"
                                    Margin="10,0,0,0" Click="RefreshManifest_Click" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
                            <RadioButton x:Name="FilterRelease" GroupName="VersionFilter" Content="正式版"
                                         Style="{StaticResource FilterChip}" IsChecked="True"
                                         Checked="VersionFilter_Changed" />
                            <RadioButton x:Name="FilterSnapshot" GroupName="VersionFilter" Content="快照"
                                         Style="{StaticResource FilterChip}" Checked="VersionFilter_Changed" />
                            <RadioButton x:Name="FilterAll" GroupName="VersionFilter" Content="全部"
                                         Style="{StaticResource FilterChip}" Checked="VersionFilter_Changed" />
                            <TextBlock x:Name="VersionResultCountText" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                        <ListBox x:Name="RemoteVersionList" Grid.Row="2"
                                 Style="{StaticResource CleanListBox}"
                                 behaviors:SmoothScroll.IsEnabled="True"
                                 ItemContainerStyle="{StaticResource CleanListItem}"
                                 PreviewMouseLeftButtonDown="RemoteVersionList_PreviewMouseLeftButtonDown"
                                 PreviewMouseLeftButtonUp="RemoteVersionList_PreviewMouseLeftButtonUp"
                                 SelectionChanged="RemoteVersionList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="14,11">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource ListItemBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource ListSelectedBrush}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Id}" FontSize="14" FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource SmallBadge}" Margin="9,0,0,0"
                                                            Padding="7,2">
                                                        <TextBlock Text="{Binding TypeLabel}" FontSize="9"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource SmallBadge}"
                                                            Background="{DynamicResource InfoBadgeBrush}"
                                                            Padding="7,2" Margin="6,0,0,0"
                                                            Visibility="{Binding IsInstalled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding InstalledBadgeLabel}" FontSize="9"
                                                                   Foreground="{DynamicResource CyanBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Style="{StaticResource SmallBadge}"
                                                            Background="{DynamicResource ChipSelectedBackgroundBrush}"
                                                            BorderBrush="{DynamicResource ChipSelectedBorderBrush}"
                                                            BorderThickness="1"
                                                            Padding="7,2" Margin="6,0,0,0"
                                                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="已选择" FontSize="9"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding ReleaseDate}" Style="{StaticResource Caption}"
                                                           Margin="0,5,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding ActionLabel}"
                                                    Tag="{Binding}" Style="{StaticResource SecondaryButton}"
                                                    Padding="15,7" Margin="12,0,0,0"
                                                    Click="DownloadVersion_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  behaviors:SmoothScroll.IsEnabled="True">
                    <StackPanel Margin="0,0,8,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="安装 Mod 加载器" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="选择加载器与版本，可为原版创建独立游戏版本。"
                                           Style="{StaticResource Caption}" Margin="0,5,0,15"
                                           TextWrapping="Wrap" />
                                <Border Style="{StaticResource InsetCard}" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="目标原版版本" Style="{StaticResource Caption}" />
                                        <TextBlock x:Name="LoaderTargetText" Text="请从左侧选择版本"
                                                   FontSize="15" FontWeight="SemiBold" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="加载器" Style="{StaticResource Caption}" Margin="0,14,0,7" />
                                <WrapPanel Margin="0,0,0,-8">
                                    <RadioButton x:Name="LoaderFabricOption" GroupName="LoaderChoice"
                                                 Content="Fabric" Tag="Fabric"
                                                 Style="{StaticResource FilterChip}"
                                                 Margin="0,0,8,8"
                                                 IsChecked="True" Checked="LoaderOption_Checked" />
                                    <RadioButton x:Name="LoaderForgeOption" GroupName="LoaderChoice"
                                                 Content="Forge" Tag="Forge"
                                                 Style="{StaticResource FilterChip}"
                                                 Margin="0,0,8,8"
                                                 Checked="LoaderOption_Checked" />
                                    <RadioButton x:Name="LoaderNeoForgeOption" GroupName="LoaderChoice"
                                                 Content="NeoForge" Tag="NeoForge"
                                                 Style="{StaticResource FilterChip}"
                                                 Margin="0,0,8,8"
                                                 Checked="LoaderOption_Checked" />
                                    <RadioButton x:Name="LoaderQuiltOption" GroupName="LoaderChoice"
                                                 Content="Quilt" Tag="Quilt"
                                                 Style="{StaticResource FilterChip}"
                                                 Margin="0,0,8,8"
                                                 Checked="LoaderOption_Checked" />
                                </WrapPanel>
                                <TextBlock Text="加载器版本" Style="{StaticResource Caption}" Margin="0,13,0,7" />
                                <ComboBox x:Name="LoaderVersionCombo"
                                          HorizontalContentAlignment="Center"
                                          SelectionChanged="LoaderVersionCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"
                                                       TextAlignment="Center" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="InstallLoaderButton" Content="安装所选加载器"
                                        Style="{StaticResource PrimaryButton}" Padding="12,10"
                                        Margin="0,11,0,0" IsEnabled="False"
                                        Click="InstallSelectedLoader_Click" />
                                <TextBlock x:Name="LoaderVersionStatus" Text="请选择目标版本"
                                           Style="{StaticResource Caption}" Margin="0,10,0,0"
                                           LineHeight="18" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,14,8,0"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="已安装版本" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="启动与 Mod 安装都基于这里选择的游戏版本。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,12" />
                        <ComboBox x:Name="InstalledVersionsSideCombo"
                                  ItemTemplate="{StaticResource InstalledVersionDisplay}"
                                          SelectionChanged="InstalledVersionsSideCombo_SelectionChanged" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="打开版本目录" Style="{StaticResource GhostButton}"
                                            HorizontalAlignment="Left" Click="OpenInstanceFolder_Click" />
                                    <Button Grid.Column="1" Content="刷新" Style="{StaticResource GhostButton}"
                                            Click="RefreshInstalled_Click" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                        <Border x:Name="VersionStatusCard" Grid.Row="1"
                                Style="{StaticResource Card}" Margin="0,10,8,12"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="版本状态" Style="{StaticResource Caption}" />
                                <TextBlock x:Name="VersionTaskStatus" Text="准备就绪" FontSize="13"
                                           FontWeight="SemiBold" Margin="0,6,0,10" />
                                <ProgressBar x:Name="VersionProgressBar" Style="{StaticResource SlimProgress}"
                                             Maximum="100" Value="0" />
                                <TextBlock x:Name="VersionProgressDetail" Style="{StaticResource Caption}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Mods -->
                <Grid x:Name="ModsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}" Padding="17">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Row="0" Grid.ColumnSpan="5" Orientation="Horizontal"
                                        Margin="0,0,0,14">
                                <TextBlock Text="内容类型" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                <RadioButton x:Name="ContentModFilter" Content="模组"
                                             GroupName="ModContentKind" Tag="Mod"
                                             Style="{StaticResource FilterChip}" IsChecked="True"
                                             Checked="ContentKindFilter_Checked" />
                                <RadioButton x:Name="ContentModpackFilter" Content="整合包"
                                             GroupName="ModContentKind" Tag="Modpack"
                                             Style="{StaticResource FilterChip}"
                                             Checked="ContentKindFilter_Checked" />
                                <RadioButton x:Name="ContentDataPackFilter" Content="数据包"
                                             GroupName="ModContentKind" Tag="DataPack"
                                             Style="{StaticResource FilterChip}"
                                             Checked="ContentKindFilter_Checked" />
                                <RadioButton x:Name="ContentResourcePackFilter" Content="资源包"
                                             GroupName="ModContentKind" Tag="ResourcePack"
                                             Style="{StaticResource FilterChip}"
                                             Checked="ContentKindFilter_Checked" />
                                <RadioButton x:Name="ContentShaderFilter" Content="光影包"
                                             GroupName="ModContentKind" Tag="Shader"
                                             Style="{StaticResource FilterChip}"
                                             Checked="ContentKindFilter_Checked" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Name="ModSearchLabel" Text="搜索"
                                           Style="{StaticResource FieldLabel}" />
                                <Grid x:Name="ModSearchArea"
                                      Background="Transparent"
                                      Cursor="IBeam"
                                      Tag="{Binding ElementName=ModSearchBox}"
                                      PreviewMouseLeftButtonDown="SearchArea_PreviewMouseLeftButtonDown">
                                    <TextBox x:Name="ModSearchBox" KeyDown="ModSearchBox_KeyDown"
                                             Style="{StaticResource SearchTextBox}"
                                             TextChanged="SearchTextBox_TextChanged"
                                             PreviewMouseLeftButtonDown="SearchTextBox_PreviewMouseLeftButtonDown"
                                             PreviewMouseLeftButtonUp="SearchTextBox_PreviewMouseLeftButtonUp"
                                             GotKeyboardFocus="SearchBox_FocusChanged"
                                             LostKeyboardFocus="SearchBox_FocusChanged" />
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                               FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="14,0,0,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                                    <TextBlock x:Name="ModSearchHint" Text="可选：输入关键词筛选热门 Mod"
                                               IsHitTestVisible="False" Foreground="{DynamicResource MutedTextBrush}"
                                               Margin="38,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                </Grid>
                            </StackPanel>
                            <Button x:Name="SearchModsButton" Grid.Row="1" Grid.Column="2" Content="搜索"
                                    Style="{StaticResource PrimaryButton}"
                                    Padding="24,11" Click="SearchMods_Click" VerticalAlignment="Bottom" />
                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="筛选游戏版本" Style="{StaticResource FieldLabel}" />
                                <TextBlock x:Name="ModsLoaderLabel" Text="加载器"
                                           Style="{StaticResource Caption}" FontSize="10"
                                           Margin="0,0,0,5" Visibility="Collapsed" />
                                <ComboBox x:Name="ModsLoaderCombo"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,7" Visibility="Collapsed"
                                          SelectionChanged="ModsLoaderCombo_SelectionChanged" />
                                <TextBlock x:Name="ModsVersionTypeLabel" Text="版本类型"
                                           Style="{StaticResource Caption}" FontSize="10"
                                           Margin="0,0,0,5" Visibility="Collapsed" />
                                <ComboBox x:Name="ModsVersionTypeCombo"
                                          Margin="0,0,0,7" Visibility="Collapsed"
                                          SelectionChanged="ModsVersionTypeCombo_SelectionChanged">
                                    <ComboBoxItem Content="正式版" Tag="release" />
                                    <ComboBoxItem Content="快照版" Tag="snapshot" />
                                    <ComboBoxItem Content="远古 Beta" Tag="old_beta" />
                                    <ComboBoxItem Content="远古 Alpha" Tag="old_alpha" />
                                </ComboBox>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ModsVersionCombo"
                                              ItemTemplate="{StaticResource ModVersionFilterDisplay}"
                                              PreviewMouseWheel="ModsVersionCombo_PreviewMouseWheel"
                                              SelectionChanged="ModsVersionCombo_SelectionChanged" />
                                    <Button x:Name="ClearModFilterButton" Grid.Column="1"
                                            Content="清空" Style="{StaticResource GhostButton}"
                                            Padding="8,10" Margin="6,0,0,0"
                                            Click="ClearModFilter_Click" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,12,0,8">
                        <TextBlock x:Name="ModTargetText" Text="选择版本会筛选 Mod；清空后下载时可重新选择目标版本。"
                                   Style="{StaticResource Caption}" />
                        <TextBlock x:Name="ModResultCountText" Text="" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Grid.Row="2">
                        <ListBox x:Name="ModResultList" Style="{StaticResource CleanListBox}"
                                 behaviors:SmoothScroll.IsEnabled="True"
                                 behaviors:SmoothScroll.WheelFactor="1.65"
                                 ItemContainerStyle="{StaticResource CleanListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ListItemBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="56" Height="56" Background="Transparent"
                                                  VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}}" />
                                                <Image Source="{Binding CoverImagePath}"
                                                       Stretch="Uniform" SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=NotNull}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="11,0,14,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontSize="13"
                                                               FontWeight="SemiBold" />
                                                    <Border Style="{StaticResource SmallBadge}" Margin="9,0,0,0"
                                                            Padding="7,2">
                                                        <TextBlock Text="{Binding SourceLabel}" FontSize="9"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                    <Border Style="{StaticResource SmallBadge}" Margin="5,0,0,0"
                                                            Padding="7,2">
                                                        <TextBlock Text="{Binding ContentKindLabel}" FontSize="9"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding AuthorLabel}" Style="{StaticResource Caption}"
                                                               Margin="7,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis" MaxHeight="30"
                                                           Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding ProjectUrl}" FontSize="9"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InfoLabel}" FontSize="11"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding InfoCaption}" Style="{StaticResource Caption}" FontSize="9"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Button Content="查看详情" Tag="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="9,6" Margin="0,0,4,0"
                                                        Click="OpenModDetails_Click" />
                                                <Button Content="{Binding Status}" Tag="{Binding}"
                                                        Padding="13,6" Click="InstallMod_Click">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ModsEmptyState" VerticalAlignment="Center"
                                    HorizontalAlignment="Center" Visibility="Collapsed">
                            <Border Width="58" Height="58" CornerRadius="18" Background="{DynamicResource EmptySurfaceBrush}"
                                    HorizontalAlignment="Center">
                                <TextBlock Text="&#xE74C;" FontFamily="{StaticResource IconFont}"
                                           FontSize="22" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="ModsEmptyTitle" Text="正在加载 Mod" FontSize="16"
                                       FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,5" />
                            <TextBlock x:Name="ModsEmptyDescription"
                                       Text="即使没有安装 Minecraft，也可以先浏览并下载 Mod。"
                                       Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            <Button x:Name="GoToVersionsButton" Content="前往版本管理"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,16,0,0" Click="GoToVersions_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Button x:Name="ModsPrevButton" Content="上一页" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Click="ModsPrev_Click" />
                        <TextBlock x:Name="ModsPageText" Text="" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Button x:Name="ModsNextButton" Content="下一页" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Right" Click="ModsNext_Click" />
                    </Grid>
                </Grid>

                <!-- Accounts -->
                <Grid x:Name="AccountsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  behaviors:SmoothScroll.IsEnabled="True">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" MinHeight="250">
                                    <StackPanel>
                                        <Grid>
                                            <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccountSurfaceBrush}"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="20" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Style="{StaticResource SmallBadge}" HorizontalAlignment="Right">
                                                <TextBlock Text="正版" FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Microsoft 账户" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="20" FontWeight="SemiBold" Margin="0,17,0,6" />
                                        <TextBlock Text="通过微软官方设备码登录，支持正版服务器与 Realms。启动器不会接触你的 Microsoft 密码。"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                                   LineHeight="19" />
                                        <Button Content="使用 Microsoft 登录" Style="{StaticResource PrimaryButton}"
                                                Margin="0,20,0,0" HorizontalAlignment="Left"
                                                Click="MicrosoftLogin_Click" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" MinHeight="250">
                                    <StackPanel>
                                        <Grid>
                                            <Border Width="48" Height="48" CornerRadius="14" Background="{DynamicResource AccountInfoSurfaceBrush}"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}"
                                                           FontSize="20" Foreground="{DynamicResource CyanBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Style="{StaticResource SmallBadge}" HorizontalAlignment="Right"
                                                    Background="{DynamicResource InfoBadgeStrongBrush}">
                                                <TextBlock Text="单机 / 离线服" FontSize="10"
                                                           Foreground="{DynamicResource CyanBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="离线账户" FontFamily="{StaticResource DisplayFont}"
                                                   FontSize="20" FontWeight="SemiBold" Margin="0,17,0,6" />
                                        <TextBlock Text="无需密码，输入玩家名即可创建本地档案。请仅用于单人或允许离线登录的服务器。"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                                                   LineHeight="19" />
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="OfflineNameBox" MaxLength="16"
                                                     TextChanged="OfflineNameBox_TextChanged"
                                                     GotKeyboardFocus="SearchBox_FocusChanged"
                                                     LostKeyboardFocus="SearchBox_FocusChanged" />
                                            <TextBlock x:Name="OfflineNameHint" Text="输入玩家名"
                                                       IsHitTestVisible="False"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       Margin="14,0,0,0" VerticalAlignment="Center"
                                                       FontSize="12" />
                                            <Button Grid.Column="1" Content="离线登录"
                                                    Style="{StaticResource SecondaryButton}" Margin="9,0,0,0"
                                                    Click="OfflineLogin_Click" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="皮肤模式" Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <ComboBox x:Name="OfflineSkinModelCombo" Grid.Column="1"
                                                      SelectedValuePath="Tag" SelectedIndex="0">
                                                <ComboBoxItem Content="Steve（经典）" Tag="Steve" />
                                                <ComboBoxItem Content="Alex（纤细）" Tag="Alex" />
                                            </ComboBox>
                                            <TextBlock Grid.Column="2" Text="使用 Mojang 官方默认皮肤"
                                                       Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,10">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="已保存账户" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="令牌使用 Windows DPAPI 加密保存，切换账户不会重复输入密码。"
                                                       Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <TextBlock x:Name="AccountsTotalText" Text="0 个账户"
                                                   Style="{StaticResource Caption}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <ScrollViewer Margin="0,14,0,0" MaxHeight="300"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  behaviors:SmoothScroll.IsEnabled="True">
                                        <ItemsControl x:Name="AccountsList"
                                                      HorizontalContentAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="AccountCard"
                                                        Background="{DynamicResource InsetBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderSoftBrush}"
                                                        BorderThickness="2" CornerRadius="10" Padding="12,9"
                                                         Margin="0,0,4,6"
                                                         Cursor="Hand"
                                                         Tag="{Binding}"
                                                         MouseLeftButtonUp="AccountCard_MouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="42" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource HeaderAvatarSurfaceBrush}">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Initial}" FontWeight="Bold"
                                                                           Foreground="{DynamicResource AccentBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Visibility="{Binding AvatarImagePath, Converter={StaticResource NullToVisibilityConverter}}" />
                                                                <Image Source="{Binding AvatarImagePath}" Stretch="Uniform"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                       SnapsToDevicePixels="True"
                                                                       Visibility="{Binding AvatarImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=NotNull}" />
                                                            </Grid>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                                    VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding KindLabel}"
                                                                       Style="{StaticResource Caption}" />
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="自定义"
                                                                Style="{StaticResource GhostButton}"
                                                                Visibility="{Binding IsMicrosoft, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                Tag="{Binding}" Click="CustomizeAccount_Click" />
                                                         <Button Grid.Column="3" Content="移除"
                                                                Style="{StaticResource GhostButton}"
                                                                Tag="{Binding}" Click="RemoveAccount_Click" />
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter TargetName="AccountCard" Property="BorderBrush"
                                                                Value="{DynamicResource AccentGradient}" />
                                                        <Setter TargetName="AccountCard" Property="Background"
                                                                Value="{DynamicResource AccentTintBrush}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Settings -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  behaviors:SmoothScroll.IsEnabled="True">
                        <StackPanel MaxWidth="850" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="游戏与性能" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="游戏版本、资源与下载缓存统一保存在所选目录的 .minecraft 文件夹中。"
                                               Style="{StaticResource Caption}" Margin="0,4,0,18" />
                                    <TextBlock Text="最大内存" FontSize="12" FontWeight="SemiBold" />
                                    <Border Style="{StaticResource InsetCard}" Padding="15,13"
                                            Margin="0,9,0,18">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="分配给 Minecraft 的最大内存"
                                                           Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" />
                                                <Border HorizontalAlignment="Right"
                                                        Background="{DynamicResource AccentTintBrush}"
                                                        CornerRadius="8" Padding="10,5">
                                                    <TextBlock x:Name="MemoryValueText" Text="4 GB"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                            <Slider x:Name="MemorySlider" Margin="0,9,0,0"
                                                    Minimum="1024" Maximum="16384"
                                                    SmallChange="256" LargeChange="1024"
                                                    TickFrequency="512" IsSnapToTickEnabled="False"
                                                    Style="{StaticResource MemorySlider}"
                                                    ValueChanged="MemorySlider_ValueChanged" />
                                            <Grid Margin="2,2,2,0">
                                                <TextBlock Text="1 GB" Style="{StaticResource Caption}" />
                                                <TextBlock Text="16 GB" Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="下载线路" FontSize="12" FontWeight="SemiBold" />
                                    <Grid Margin="0,8,0,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="270" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="DownloadRouteCombo" SelectedValuePath="Tag"
                                                  SelectionChanged="DownloadRouteCombo_SelectionChanged">
                                            <ComboBoxItem Content="自动测速（推荐）" Tag="Automatic" />
                                            <ComboBoxItem Content="Mojang 官方线路" Tag="Official" />
                                            <ComboBoxItem Content="BMCLAPI 国内镜像" Tag="DomesticMirror" />
                                        </ComboBox>
                                        <TextBlock Grid.Column="1" Text="自动模式会在每次安装前比较线路速度，镜像失败时自动回退官方。"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center"
                                                   Margin="14,0,0,0" />
                                    </Grid>
                                    <TextBlock Text="游戏目录（便携模式）" FontSize="12" FontWeight="SemiBold" />
                                    <Grid Margin="0,8,0,6">
                                        <TextBox x:Name="DataDirectoryBox" IsReadOnly="True" />
                                    </Grid>
                                    <TextBlock Text="固定使用启动器所在文件夹下的 .minecraft，不读取其他游戏目录。"
                                               Style="{StaticResource Caption}" Margin="0,0,0,18" />
                                    <TextBlock Text="Java 路径（留空自动管理）"
                                               FontSize="12" FontWeight="SemiBold" />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="JavaPathBox"
                                                 TextChanged="AutoSettingsTextChanged" />
                                        <Button Grid.Column="1" Content="浏览"
                                                Style="{StaticResource SecondaryButton}"
                                                Margin="9,0,0,0" Click="BrowseJava_Click" />
                                        <Button Grid.Column="2" Content="清除"
                                                Style="{StaticResource GhostButton}"
                                                Margin="5,0,0,0" Click="ClearJava_Click" />
                                    </Grid>
                                    <TextBlock Text="JVM 参数" FontSize="12"
                                               FontWeight="SemiBold" Margin="0,16,0,0" />
                                    <TextBox x:Name="JvmArgumentsBox" Margin="0,8,0,0"
                                             MinHeight="58" MaxHeight="88"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             TextChanged="AutoSettingsTextChanged"
                                             ToolTip="例如：-XX:+UseG1GC -XX:+ParallelRefProcEnabled" />
                                    <TextBlock Text="游戏参数" FontSize="12"
                                               FontWeight="SemiBold" Margin="0,16,0,0" />
                                    <TextBox x:Name="GameArgumentsBox" Margin="0,8,0,0"
                                             MinHeight="58" MaxHeight="88"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             TextChanged="AutoSettingsTextChanged"
                                             ToolTip="会追加到 Minecraft 游戏参数末尾" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="全局游戏设置" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="启用后，启动任何游戏版本时都会同步以下 Minecraft 选项，不会只修改当前版本。"
                                               Style="{StaticResource Caption}" Margin="0,4,0,16"
                                               TextWrapping="Wrap" />
                                    <CheckBox x:Name="GlobalGameOptionsCheck" Content="启用全局游戏设置"
                                              Style="{StaticResource SwitchCheckBox}"
                                              Checked="GlobalGameOptionsEnabled_Changed"
                                              Unchecked="GlobalGameOptionsEnabled_Changed" />
                                    <Grid x:Name="GlobalGameOptionsPanel" Margin="0,18,0,0"
                                          IsEnabled="False" Opacity="0.55">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="14" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="20" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="游戏语言" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="GlobalGameLanguageCombo"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="GlobalGameOption_Changed">
                                                <ComboBoxItem Content="简体中文" Tag="zh_cn" />
                                                <ComboBoxItem Content="English" Tag="en_us" />
                                                <ComboBoxItem Content="日本語" Tag="ja_jp" />
                                                <ComboBoxItem Content="한국어" Tag="ko_kr" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="GUI 缩放" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="GlobalGameGuiScaleCombo"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="GlobalGameOption_Changed">
                                                <ComboBoxItem Content="自动" Tag="0" />
                                                <ComboBoxItem Content="小" Tag="1" />
                                                <ComboBoxItem Content="中" Tag="2" />
                                                <ComboBoxItem Content="大" Tag="3" />
                                                <ComboBoxItem Content="超大" Tag="4" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2">
                                            <TextBlock Text="视距" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="GlobalGameRenderDistanceCombo"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="GlobalGameOption_Changed">
                                                <ComboBoxItem Content="8 区块" Tag="8" />
                                                <ComboBoxItem Content="12 区块" Tag="12" />
                                                <ComboBoxItem Content="16 区块" Tag="16" />
                                                <ComboBoxItem Content="20 区块" Tag="20" />
                                                <ComboBoxItem Content="24 区块" Tag="24" />
                                                <ComboBoxItem Content="32 区块" Tag="32" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="模拟距离" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="GlobalGameSimulationDistanceCombo"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="GlobalGameOption_Changed">
                                                <ComboBoxItem Content="5 区块" Tag="5" />
                                                <ComboBoxItem Content="8 区块" Tag="8" />
                                                <ComboBoxItem Content="12 区块" Tag="12" />
                                                <ComboBoxItem Content="16 区块" Tag="16" />
                                                <ComboBoxItem Content="20 区块" Tag="20" />
                                                <ComboBoxItem Content="32 区块" Tag="32" />
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4">
                                            <TextBlock Text="最大帧率" Style="{StaticResource FieldLabel}" />
                                            <ComboBox x:Name="GlobalGameMaxFpsCombo"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="GlobalGameOption_Changed">
                                                <ComboBoxItem Content="60 FPS" Tag="60" />
                                                <ComboBoxItem Content="90 FPS" Tag="90" />
                                                <ComboBoxItem Content="120 FPS" Tag="120" />
                                                <ComboBoxItem Content="144 FPS" Tag="144" />
                                                <ComboBoxItem Content="240 FPS" Tag="240" />
                                                <ComboBoxItem Content="260 FPS" Tag="260" />
                                                <ComboBoxItem Content="无限制" Tag="0" />
                                            </ComboBox>
                                        </StackPanel>
                                        <CheckBox x:Name="GlobalGameFullscreenCheck"
                                                  Grid.Row="4" Grid.Column="2"
                                                  Content="启动时全屏"
                                                  Style="{StaticResource SwitchCheckBox}"
                                                  Margin="0,27,0,0"
                                                  Checked="GlobalGameOptionToggle_Changed"
                                                  Unchecked="GlobalGameOptionToggle_Changed" />

                                        <CheckBox x:Name="GlobalGameVsyncCheck"
                                                  Grid.Row="6"
                                                  Content="启用垂直同步"
                                                  Style="{StaticResource SwitchCheckBox}"
                                                  Checked="GlobalGameOptionToggle_Changed"
                                                  Unchecked="GlobalGameOptionToggle_Changed" />
                                        <CheckBox x:Name="GlobalGamePauseCheck"
                                                  Grid.Row="6" Grid.Column="2"
                                                  Content="失去焦点时暂停"
                                                  Style="{StaticResource SwitchCheckBox}"
                                                  Checked="GlobalGameOptionToggle_Changed"
                                                  Unchecked="GlobalGameOptionToggle_Changed" />

                                        <Border Grid.Row="7" Grid.ColumnSpan="3" Height="1"
                                                Background="{DynamicResource BorderSoftBrush}" />
                                        <StackPanel Grid.Row="8" Grid.ColumnSpan="3">
                                            <TextBlock Text="按键设置" Style="{StaticResource FieldLabel}" />
                                            <TextBlock Text="从一个已经启动过的版本导入完整按键方案，再同步到其他版本。"
                                                       Style="{StaticResource Caption}" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid Grid.Row="10" Grid.ColumnSpan="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="9" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="7" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="GlobalGameKeybindingsSourceCombo"
                                                      ItemTemplate="{StaticResource InstalledVersionDisplay}" />
                                            <Button Grid.Column="2" Content="导入按键"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="12,7"
                                                    Click="ImportGlobalGameKeybindings_Click" />
                                            <Button Grid.Column="4" Content="清除"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="10,7"
                                                    Click="ClearGlobalGameKeybindings_Click" />
                                        </Grid>
                                        <Grid Grid.Row="12" Grid.ColumnSpan="3">
                                            <CheckBox x:Name="GlobalGameSyncKeybindingsCheck"
                                                      Content="同步按键设置"
                                                      Style="{StaticResource SwitchCheckBox}"
                                                      Checked="GlobalGameSyncKeybindings_Changed"
                                                      Unchecked="GlobalGameSyncKeybindings_Changed" />
                                            <TextBlock x:Name="GlobalGameKeybindingsStatusText"
                                                       Text="尚未导入按键方案"
                                                       Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="外观主题" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="主题会立即应用并保存，下次启动时继续使用。"
                                               Style="{StaticResource Caption}" Margin="0,4,0,16" />
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeDarkOption" GroupName="ThemeMode"
                                                     Content="深色" Tag="Dark"
                                                     Style="{StaticResource FilterChip}"
                                                     Checked="ThemeOption_Checked" />
                                        <RadioButton x:Name="ThemeLightOption" GroupName="ThemeMode"
                                                     Content="浅色" Tag="Light"
                                                     Style="{StaticResource FilterChip}"
                                                     Checked="ThemeOption_Checked" />
                                        <RadioButton x:Name="ThemeSystemOption" GroupName="ThemeMode"
                                                     Content="跟随系统" Tag="System"
                                                     Style="{StaticResource FilterChip}"
                                                     Checked="ThemeOption_Checked" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="启动器行为" Style="{StaticResource SectionTitle}" />
                                    <CheckBox x:Name="HideLauncherDuringGameCheck" Content="启动游戏时隐藏启动器"
                                              Style="{StaticResource SwitchCheckBox}" Margin="0,17,0,0"
                                              Checked="AutoSettingsToggle_Changed"
                                              Unchecked="AutoSettingsToggle_Changed" />
                                    <TextBlock Text="开启后，游戏运行期间隐藏启动器；退出游戏后自动重新显示。"
                                               Style="{StaticResource Caption}" Margin="46,5,0,0" />
                                    <CheckBox x:Name="VersionIsolationCheck" Content="启用版本隔离"
                                              Style="{StaticResource SwitchCheckBox}" Margin="0,17,0,0"
                                              Checked="AutoSettingsToggle_Changed"
                                              Unchecked="AutoSettingsToggle_Changed" />
                                    <TextBlock Text="开启后，每个版本使用独立的存档、Mod 和配置；关闭后共用 Minecraft 根目录。"
                                               Style="{StaticResource Caption}" Margin="46,5,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Button Content="打开数据目录" Style="{StaticResource GhostButton}"
                                        HorizontalAlignment="Left" Click="OpenDataDirectory_Click" />
                                <TextBlock Text="设置会自动保存" Style="{StaticResource Caption}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,18,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Static app:AppInfo.ProductLabel}" FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="原生 WPF · Mojang 官方资源 · Modrinth / CurseForge"
                                                   Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="与 Mojang / Microsoft 无隶属关系"
                                               Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="SupportAuthor_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="支持作者" FontSize="13"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="查看微信赞赏码，感谢支持喵~"
                                                   Style="{StaticResource Caption}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="查看赞赏码  ›"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource BorderSoftBrush}"
                    BorderThickness="0,1,0,0" Padding="28,0">
                <Grid>
                    <TextBlock x:Name="GlobalStatusText" Text="就绪"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="10"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ProgressBar x:Name="GlobalProgressBar" Style="{StaticResource SlimProgress}"
                                     Width="150" Height="6" Maximum="100" Value="0" Margin="0,0,10,0" />
                        <Button x:Name="CancelOperationButton" Content="取消"
                                Style="{StaticResource GhostButton}" Padding="7,2" FontSize="10"
                                Visibility="Collapsed" Click="CancelOperation_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Mod details dialog -->
        <Grid x:Name="ModDetailOverlay" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
              Visibility="Collapsed" Panel.ZIndex="18">
            <Border Width="820" MaxHeight="640" Style="{StaticResource Card}" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Margin="0,0,52,0">
                            <TextBlock x:Name="ModDetailTitleText" Text="Mod 详情"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="24"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Style="{StaticResource SmallBadge}" Padding="8,3">
                                    <TextBlock x:Name="ModDetailSourceText" Text="Modrinth"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock x:Name="ModDetailMetaText" Style="{StaticResource Caption}"
                                           VerticalAlignment="Center" Margin="9,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CloseModDetails_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="190" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource InsetCard}" Padding="16" MinHeight="300">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              behaviors:SmoothScroll.IsEnabled="True">
                                    <StackPanel>
                                        <TextBlock x:Name="ModDetailDescriptionLabel" Text="模组介绍"
                                                   Style="{StaticResource Caption}"
                                                   FontWeight="SemiBold" Margin="0,0,0,9" />
                                        <TextBlock x:Name="ModDetailDescriptionText"
                                                   Text="正在加载模组介绍…" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" LineHeight="20" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <Border Grid.Column="2" Style="{StaticResource InsetCard}" Padding="16">
                            <StackPanel>
                                <Grid Height="128" Background="Transparent">
                                    <TextBlock x:Name="ModDetailInitialText" Text="M"
                                               FontSize="32" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="ModDetailCoverImage" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </Grid>
                                <TextBlock Text="下载目标" Style="{StaticResource Caption}"
                                           Margin="0,16,0,7" />
                                <Button x:Name="ModDetailInstallButton" Content="安装"
                                        Style="{StaticResource PrimaryButton}"
                                        Click="InstallMod_Click" />
                                <TextBlock x:Name="ModDetailInstallStatusText" Text=""
                                           Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
                        <TextBlock Text="项目链接" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="ModDetailMcmodButton" Content="MC百科"
                                Style="{StaticResource GhostButton}" Padding="9,5"
                                Visibility="Collapsed" Click="OpenModDetailLink_Click" />
                        <Button x:Name="ModDetailModrinthButton" Content="Modrinth"
                                Style="{StaticResource GhostButton}" Padding="9,5"
                                Visibility="Collapsed" Click="OpenModDetailLink_Click" />
                        <Button x:Name="ModDetailCurseForgeButton" Content="CurseForge"
                                Style="{StaticResource GhostButton}" Padding="9,5"
                                Visibility="Collapsed" Click="OpenModDetailLink_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Mod file version selection -->
        <Grid x:Name="ModVersionOverlay" Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}"
              Visibility="Collapsed" Panel.ZIndex="21">
            <Border Width="680" MaxHeight="620" Style="{StaticResource Card}"
                    Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Margin="0,0,52,0">
                            <TextBlock Text="选择模组版本"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="ModVersionProjectText" Text=""
                                       Style="{StaticResource Caption}"
                                       Margin="0,6,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CancelModVersionSelection_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,18,0,0">
                        <ListBox x:Name="ModVersionList"
                                 Style="{StaticResource CleanListBox}"
                                 behaviors:SmoothScroll.IsEnabled="True"
                                 SelectionChanged="ModVersionList_SelectionChanged"
                                 ItemContainerStyle="{StaticResource CleanCardListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10"
                                            Padding="14,11">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource ListItemBrush}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource BorderSoftBrush}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource ListHoverBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource ListSelectedBrush}" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource AccentBrush}" />
                                                        <Setter Property="BorderThickness" Value="1.5" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding VersionName}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding FileName}"
                                                           Style="{StaticResource Caption}"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DetailLabel}"
                                                       Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ModVersionEmptyText"
                                   Text="没有找到适用于当前版本和加载器的历史文件。"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="取消" Style="{StaticResource SecondaryButton}"
                                Click="CancelModVersionSelection_Click" />
                        <Button x:Name="SelectModVersionButton" Grid.Column="2"
                                Content="使用所选版本"
                                Style="{StaticResource PrimaryButton}"
                                IsEnabled="False"
                                Click="AcceptModVersionSelection_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Mod install target dialog -->
        <Grid x:Name="ModTargetOverlay" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
              Visibility="Collapsed" Panel.ZIndex="19">
            <Border Width="520" Style="{StaticResource Card}" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="0">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,48,0">
                            <TextBlock x:Name="ModTargetTitleText" Text="选择 Mod 下载目标"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="ModTargetModNameText" Text=""
                                       Style="{StaticResource Caption}" Margin="0,5,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CancelModTargetSelection_Click" />
                    </Grid>

                    <TextBlock Text="Minecraft 版本" Style="{StaticResource FieldLabel}"
                               Margin="0,20,0,7" />
                    <ComboBox x:Name="ModTargetVersionCombo">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource Caption}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock x:Name="ModTargetLoaderLabel" Text="Mod 加载器"
                               Style="{StaticResource FieldLabel}"
                               Margin="0,14,0,7" />
                    <ComboBox x:Name="ModTargetLoaderCombo"
                              DisplayMemberPath="DisplayName" />

                    <TextBlock x:Name="ModTargetStatusText" Text=""
                               Style="{StaticResource Caption}" Margin="0,12,0,0"
                               TextWrapping="Wrap" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="取消" Style="{StaticResource SecondaryButton}"
                                Click="CancelModTargetSelection_Click" />
                        <Button Grid.Column="2" Content="选择保存位置"
                                Style="{StaticResource PrimaryButton}"
                                Click="AcceptModTargetSelection_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Version rename dialog -->
        <Grid x:Name="VersionRenameOverlay" Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" Panel.ZIndex="22">
            <Border Width="430" Style="{StaticResource Card}" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="重命名版本" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22" FontWeight="SemiBold" />
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CancelVersionRename_Click" />
                    </Grid>
                    <TextBlock Text="只修改列表中的显示名称，不会改变版本 ID 或安装目录。"
                               Style="{StaticResource Caption}" Margin="0,7,0,16"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="VersionRenameBox" MaxLength="48"
                             KeyDown="VersionRenameBox_KeyDown" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="取消" Style="{StaticResource SecondaryButton}"
                                Click="CancelVersionRename_Click" />
                        <Button Grid.Column="2" Content="保存名称"
                                Style="{StaticResource PrimaryButton}"
                                Click="ConfirmVersionRename_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Install confirmation dialog -->
        <Grid x:Name="ConfirmOverlay" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
              Visibility="Collapsed" Panel.ZIndex="19">
            <Border Width="440" Style="{StaticResource Card}" Padding="28" HorizontalAlignment="Center"
                    VerticalAlignment="Center" BorderThickness="0">
                <StackPanel>
                    <Grid>
                        <Border x:Name="ConfirmIconBorder" Width="46" Height="46" CornerRadius="14"
                                Background="{DynamicResource AccountSurfaceBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="ConfirmIconText" Text="&#xE73E;"
                                       FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" Click="CancelInstallConfirm_Click" />
                    </Grid>
                    <TextBlock x:Name="ConfirmTitleText" Text="确认安装"
                               FontFamily="{StaticResource DisplayFont}" FontSize="22"
                               FontWeight="SemiBold" Margin="0,17,0,8" />
                    <TextBlock x:Name="ConfirmMessageText" Text="是否开始安装？"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                               LineHeight="19" />
                    <Border Style="{StaticResource InsetCard}" Margin="0,18,0,0" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="ConfirmTargetLabel" Text="安装目标"
                                       Style="{StaticResource Caption}" FontSize="10" />
                            <Grid Margin="0,5,0,0">
                                <TextBlock x:Name="ConfirmTargetText" Text=""
                                           FontSize="14" FontWeight="SemiBold" />
                                <ComboBox x:Name="ConfirmVersionCombo" Visibility="Collapsed"
                                          ItemTemplate="{StaticResource InstalledVersionDisplay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ConfirmDependencySection" Visibility="Collapsed"
                                Margin="0,14,0,0">
                        <TextBlock Text="需要下载的前置" Style="{StaticResource Caption}"
                                   FontSize="10" />
                        <Border Style="{StaticResource InsetCard}" Margin="0,7,0,0" Padding="0">
                            <ScrollViewer MaxHeight="170"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          behaviors:SmoothScroll.IsEnabled="True">
                                <ItemsControl x:Name="ConfirmDependencyList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="12,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding DetailLabel}"
                                                               Style="{StaticResource Caption}"
                                                               FontSize="9"
                                                               Margin="0,3,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1"
                                                        Style="{StaticResource SmallBadge}"
                                                        Padding="7,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="前置" FontSize="9"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                        <TextBlock x:Name="ConfirmDependencyHint" Text=""
                                   Style="{StaticResource Caption}"
                                   FontSize="10" Margin="0,6,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ConfirmLoaderSection" Visibility="Collapsed" Margin="0,14,0,0">
                        <TextBlock Text="Mod 加载器" Style="{StaticResource Caption}" FontSize="10" />
                        <ComboBox x:Name="ConfirmLoaderKindCombo" Margin="0,6,0,0"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="ConfirmLoaderKindCombo_SelectionChanged" />
                        <TextBlock x:Name="ConfirmLoaderVersionLabel" Text="加载器版本"
                                   Style="{StaticResource Caption}" FontSize="10"
                                   Margin="0,10,0,6" Visibility="Collapsed" />
                        <ComboBox x:Name="ConfirmLoaderVersionCombo" Visibility="Collapsed"
                                  SelectionChanged="ConfirmLoaderVersionCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <CheckBox x:Name="ConfirmOptiFabricCheck" Visibility="Collapsed"
                                  Content="同时安装 OptiFabric"
                                  Style="{StaticResource SwitchCheckBox}"
                                  Margin="0,10,0,0"
                                  Checked="ConfirmOptiFabric_Changed"
                                  Unchecked="ConfirmOptiFabric_Changed" />
                        <TextBlock x:Name="ConfirmOptiFineVersionLabel" Text="OptiFine 版本"
                                   Style="{StaticResource Caption}" FontSize="10"
                                   Margin="0,10,0,6" Visibility="Collapsed" />
                        <ComboBox x:Name="ConfirmOptiFineVersionCombo" Visibility="Collapsed"
                                  SelectionChanged="ConfirmOptiFineVersionCombo_SelectionChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="ConfirmLoaderStatus" Text=""
                                   Style="{StaticResource Caption}" FontSize="10"
                                   Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel x:Name="ConfirmVersionNameSection" Visibility="Collapsed"
                                Margin="0,14,0,0">
                        <TextBlock Text="版本名称" Style="{StaticResource Caption}" FontSize="10" />
                        <TextBox x:Name="ConfirmVersionNameBox" MaxLength="48"
                                 Margin="0,6,0,0"
                                 TextChanged="ConfirmVersionNameBox_TextChanged" />
                        <TextBlock x:Name="ConfirmVersionNameHint"
                                   Text="输入不同名称会创建独立版本目录；留空时使用默认目录。"
                                   Style="{StaticResource Caption}"
                                   FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="安装会在后台进行，可随时取消；已完成的部分不会重复下载。"
                               Style="{StaticResource Caption}" Margin="0,12,0,0" />
                    <Grid Margin="0,22,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="取消" Style="{StaticResource SecondaryButton}"
                                Click="CancelInstallConfirm_Click" />
                        <Button x:Name="ConfirmInstallButton" Grid.Column="2" Content="确认安装"
                                Style="{StaticResource PrimaryButton}"
                                Click="AcceptInstallConfirm_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Device code dialog -->
        <Grid x:Name="AuthOverlay" Grid.ColumnSpan="2" Background="{DynamicResource OverlayBrush}"
              Visibility="Collapsed" Panel.ZIndex="20">
            <Border Width="430" Style="{StaticResource Card}" Padding="28" HorizontalAlignment="Center"
                    VerticalAlignment="Center" BorderThickness="0">
                <StackPanel>
                    <Grid>
                        <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource AccountSurfaceBrush}"
                                HorizontalAlignment="Left">
                            <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" Click="CancelAuth_Click" />
                    </Grid>
                    <TextBlock Text="登录 Microsoft" FontFamily="{StaticResource DisplayFont}"
                               FontSize="22" FontWeight="SemiBold" Margin="0,17,0,7" />
                    <TextBlock Text="浏览器已打开。输入下面的代码并选择你的 Microsoft 账户。"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"
                               LineHeight="19" />
                    <Border Style="{StaticResource InsetCard}" Margin="0,20,0,0" Padding="18">
                        <TextBlock x:Name="DeviceCodeText" Text="--------"
                                   FontFamily="Cascadia Mono, Consolas" FontSize="28"
                                   FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="9" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="复制代码" Style="{StaticResource SecondaryButton}"
                                Click="CopyDeviceCode_Click" />
                        <Button Grid.Column="2" Content="重新打开页面"
                                Style="{StaticResource SecondaryButton}"
                                Click="OpenAuthPage_Click" />
                    </Grid>
                    <TextBlock x:Name="AuthOverlayStatus" Text="等待浏览器登录…"
                               Style="{StaticResource Caption}" Margin="0,18,0,0"
                               HorizontalAlignment="Center" />
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource SlimProgress}"
                                 Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Minecraft profile customization dialog -->
        <Grid x:Name="ProfileCustomizationOverlay" Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}" Visibility="Collapsed" Panel.ZIndex="21">
            <Border Width="820" MaxHeight="660" Style="{StaticResource Card}" Padding="26"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="0"
                    PreviewMouseWheel="ProfileCustomizationContent_PreviewMouseWheel">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="自定义外观" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="上传 Minecraft 皮肤，并选择这个正版账户拥有的官方披风。"
                                       Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CloseProfileCustomization_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="238" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="当前外观" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource InsetCard}" Margin="0,13,0,0"
                                    Padding="10" ClipToBounds="True">
                                <StackPanel>
                                    <controls:PlayerModel3DView x:Name="CustomizationPlayerModel"
                                                                Height="250" />
                                    <TextBlock Text="行走预览 · 拖动可旋转模型"
                                               Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                                    <TextBlock x:Name="CustomizationNameText" Text="Microsoft 账户"
                                               FontSize="15" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" Margin="0,9,0,0" />
                                    <TextBlock x:Name="CustomizationModelText" Text="正在读取皮肤模型…"
                                               Style="{StaticResource Caption}" Margin="0,5,0,0"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <ScrollViewer x:Name="ProfileCustomizationScrollViewer"
                                      Grid.Column="0" MaxHeight="500"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      behaviors:SmoothScroll.IsEnabled="True">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="皮肤" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="支持 64×64 或 64×32 像素的 PNG 文件。上传后会立即应用到 Minecraft 账户。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,12"
                                           TextWrapping="Wrap" />
                                <Border Style="{StaticResource InsetCard}" Padding="14">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomizationSkinFileText"
                                                     Text="尚未选择新皮肤" IsReadOnly="True" />
                                            <Button x:Name="CustomizationBrowseSkinButton"
                                                    Grid.Column="1" Content="选择 PNG"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Margin="9,0,0,0"
                                                    Click="BrowseCustomizationSkin_Click" />
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CustomizationSkinModelCombo"
                                                      SelectedValuePath="Tag" SelectedIndex="0"
                                                      SelectionChanged="CustomizationSkinModelCombo_SelectionChanged">
                                                <ComboBoxItem Content="经典（Steve）" Tag="Classic" />
                                                <ComboBoxItem Content="纤细（Alex）" Tag="Slim" />
                                            </ComboBox>
                                            <TextBlock Grid.Column="1" Text="选择皮肤的手臂模型"
                                                       Style="{StaticResource Caption}"
                                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <Button x:Name="CustomizationUploadSkinButton"
                                                    Grid.Column="2" Content="上传皮肤"
                                                    Style="{StaticResource PrimaryButton}"
                                                    IsEnabled="False"
                                                    Click="UploadCustomizationSkin_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="披风" Style="{StaticResource SectionTitle}" Margin="0,20,0,0" />
                                <TextBlock Text="这里只显示该账户已经拥有的官方披风；没有披风时会自动显示“不使用披风”。"
                                           Style="{StaticResource Caption}" Margin="0,4,0,12"
                                           TextWrapping="Wrap" />
                                <Border Style="{StaticResource InsetCard}" Padding="14">
                                    <StackPanel>
                                        <TextBlock x:Name="CustomizationCapeCountText" Text="披风 (0)"
                                                   FontSize="13" FontWeight="SemiBold" />
                                        <ListBox x:Name="CustomizationCapeList"
                                                 Margin="0,10,0,0" MaxHeight="320"
                                                 Background="Transparent" BorderThickness="0"
                                                 FocusVisualStyle="{x:Null}"
                                                 Padding="0,0,6,0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 SelectionChanged="CustomizationCapeList_SelectionChanged">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem"
                                                       BasedOn="{StaticResource CleanListItem}">
                                                    <Setter Property="Margin" Value="3" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="CapeTile"
                                                            Background="{DynamicResource PanelRaisedBrush}"
                                                            BorderBrush="{DynamicResource BorderSoftBrush}"
                                                            BorderThickness="1" CornerRadius="4">
                                                        <StackPanel>
                                                            <Grid Height="112">
                                                                <Image x:Name="CapeImage"
                                                                       Source="{Binding TexturePath, Converter={StaticResource CapeTextureCroppedConverter}}"
                                                                       Width="58" Height="92" Stretch="Fill"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                                       SnapsToDevicePixels="True" />
                                                                <Rectangle x:Name="NoCapePlaceholder"
                                                                           Width="58" Height="92"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Stroke="{DynamicResource SecondaryTextBrush}"
                                                                           StrokeThickness="1"
                                                                           StrokeDashArray="3,3"
                                                                           Visibility="Collapsed" />
                                                            </Grid>
                                                            <Border Height="34" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    Background="{DynamicResource PanelRaisedBrush}"
                                                                    Padding="9,0">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="22" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Grid Width="18" Height="18"
                                                                          VerticalAlignment="Center">
                                                                        <Ellipse Fill="Transparent"
                                                                                 Stroke="{DynamicResource SecondaryTextBrush}"
                                                                                 StrokeThickness="1.5" />
                                                                        <Ellipse x:Name="SelectedDot"
                                                                                 Width="10" Height="10"
                                                                                 Fill="{DynamicResource AccentBrush}"
                                                                                 Visibility="Collapsed" />
                                                                    </Grid>
                                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                               FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <Trigger SourceName="CapeTile" Property="IsMouseOver"
                                                                 Value="True">
                                                            <Setter TargetName="CapeTile" Property="BorderBrush"
                                                                    Value="{DynamicResource ComboHoverBorderBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                     Value="True">
                                                            <Setter TargetName="CapeTile" Property="BorderBrush"
                                                                    Value="{DynamicResource AccentBrush}" />
                                                            <Setter TargetName="SelectedDot" Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding TexturePath}" Value="{x:Null}">
                                                            <Setter TargetName="CapeImage" Property="Visibility"
                                                                    Value="Collapsed" />
                                                            <Setter TargetName="NoCapePlaceholder" Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Button x:Name="CustomizationApplyCapeButton"
                                                Content="应用披风"
                                                Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Right" Margin="0,8,0,0"
                                                IsEnabled="False"
                                                Click="ApplyCustomizationCape_Click" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CustomizationStatusText"
                                       Text="正在读取 Minecraft 档案…"
                                       Style="{StaticResource Caption}" />
                            <ProgressBar x:Name="CustomizationProgressBar"
                                         IsIndeterminate="True" Style="{StaticResource SlimProgress}"
                                         Width="260" HorizontalAlignment="Left"
                                         Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="完成"
                                Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Bottom"
                                Click="CloseProfileCustomization_Click" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Installed Mod list dialog -->
        <Grid x:Name="LoadedModsOverlay" Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}" Visibility="Collapsed"
              Panel.ZIndex="22">
            <Border Width="660" MaxHeight="640" Style="{StaticResource Card}" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Margin="0,0,48,0">
                            <TextBlock Text="已加载 Mod" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="LoadedModsVersionText" Text=""
                                       Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CloseLoadedMods_Click" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,0,0" MinHeight="240">
                        <ListBox x:Name="LoadedModsList"
                                 Style="{StaticResource CleanListBox}"
                                 ItemContainerStyle="{StaticResource CleanListItem}"
                                 behaviors:SmoothScroll.IsEnabled="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" CornerRadius="10"
                                            Padding="12,9">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource ListItemBrush}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource BorderSoftBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource DangerTintBrush}" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="56" Height="56" Background="Transparent"
                                                  VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}}" />
                                                <Image Source="{Binding CoverImagePath}"
                                                       Stretch="Uniform" SnapsToDevicePixels="True"
                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                       Visibility="{Binding CoverImagePath, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=NotNull}" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" Margin="11,0,14,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PrimaryName}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Style="{StaticResource SmallBadge}"
                                                            Margin="9,0,0,0" Padding="7,2">
                                                        <TextBlock Text="本地 Mod" FontSize="9"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DetailLabel}"
                                                           Style="{StaticResource Caption}"
                                                           Margin="0,5,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ModId}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Padding="9,4" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border"
                                                               BasedOn="{StaticResource SmallBadge}">
                                                            <Setter Property="Background"
                                                                    Value="{DynamicResource BadgeSurfaceBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="{DynamicResource DangerTintBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StateLabel}" FontSize="10">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground"
                                                                        Value="{DynamicResource AccentBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                        <Setter Property="Foreground"
                                                                                Value="{DynamicResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <Button Content="{Binding ToggleActionLabel}"
                                                        Tag="{Binding}"
                                                        Click="ToggleLoadedMod_Click"
                                                        Margin="10,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button"
                                                               BasedOn="{StaticResource GhostButton}">
                                                            <Setter Property="Padding" Value="10,7" />
                                                            <Setter Property="FontSize" Value="10" />
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource DangerBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="LoadedModsEmptyState" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="这个版本还没有加载 Mod"
                                       FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="将 Mod 文件放入 mods 文件夹后会显示在这里。"
                                       Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <TextBlock x:Name="LoadedModsCountText" Text=""
                                   Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="刷新" Style="{StaticResource GhostButton}"
                                    Padding="12,7" Click="RefreshLoadedMods_Click" />
                            <Button Content="打开 Mod 目录"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="14,7" Margin="8,0,0,0"
                                    Click="OpenLoadedModsDirectory_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Appreciation dialog -->
        <Grid x:Name="AppreciationOverlay" Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}" Visibility="Collapsed"
              Panel.ZIndex="23">
            <Border Width="458" Style="{StaticResource Card}" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="0">
                <StackPanel>
                    <Grid>
                        <StackPanel Margin="0,0,48,0">
                            <TextBlock Text="支持库莫" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="感谢支持喵~"
                                       Style="{StaticResource Caption}" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button Content="&#x00D7;" FontFamily="{StaticResource BodyFont}"
                                FontSize="18" Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Click="CloseAppreciation_Click" />
                    </Grid>
                    <Border Margin="0,18,0,0" Padding="8" CornerRadius="14"
                            Background="#FFFFFF" ClipToBounds="True">
                        <Image Source="Assets/AppreciationCode.jpg" Width="400"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="微信扫码赞赏" Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ModpackDropOverlay" Grid.ColumnSpan="2"
              Background="{DynamicResource OverlayBrush}" Visibility="Collapsed"
              IsHitTestVisible="False" Panel.ZIndex="40">
            <Border Width="470" Style="{StaticResource Card}" Padding="34"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="{DynamicResource AccentBrush}">
                <StackPanel>
                    <TextBlock Text="安装整合包"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="24" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="松开鼠标以安装 Modrinth 或 CurseForge 整合包"
                               Style="{StaticResource Caption}"
                               HorizontalAlignment="Center" Margin="0,9,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
